# Database (PostgreSQL)
DATABASE_URL="mysql://root:password@localhost:3306/rippleport"

# NextAuth
# Local dev only — in production set to your live domain (e.g. https://sailxchina.com)
NEXTAUTH_URL="http://localhost:3000"
# Production: set to your public site URL (sign-out, emails, metadata)
NEXT_PUBLIC_APP_URL="https://sailxchina.com"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Admin login (sign in with this email + password, then enter emailed OTP)
ADMIN_EMAIL="admin@rippleport.com"
ADMIN_PASSWORD="Admin@Rippleport2026"
# Optional comma-separated admin login emails (overrides ADMIN_EMAIL default)
# ADMIN_EMAILS="admin@rippleport.com"
# Verification OTP is sent to both emails below (override with ADMIN_VERIFICATION_EMAILS)
ADMIN_VERIFICATION_EMAILS="prajwaldomains@gmail.com,saahilhussain735@gmail.com"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# SMTP / Email
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="sailxchinacode@gmail.com"
SMTP_PASSWORD=""
SMTP_FROM="sailxchina <sailxchinacode@gmail.com>"

# Razorpay (leave blank for demo/test mode)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Upload storage — REQUIRED in production (persistent path outside the deploy folder)
# Example VPS: UPLOAD_DIR="/var/www/uploads"
UPLOAD_DIR=""

# AWS S3 (optional)
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""

# Socket.io
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"
