// Rippleport Prisma schema
// Run: npx prisma generate && npx prisma migrate dev

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  AGENT
  SUPPLIER
  ADMIN
}

enum RFQStatus {
  DRAFT
  PENDING
  SOURCING
  QUOTATIONS_RECEIVED
  SAMPLE_STAGE
  PRODUCTION
  SHIPPING
  DELIVERED
  CANCELLED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PRODUCTION
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ShipmentStatus {
  PREPARING
  PICKED_UP
  IN_TRANSIT
  AT_PORT
  CUSTOMS
  OUT_FOR_DELIVERY
  DELIVERED
}

enum QuotationStatus {
  PENDING
  ACCEPTED
  REJECTED
  NEGOTIATING
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}

enum SampleStatus {
  REQUESTED
  SHIPPED
  DELIVERED
  APPROVED
  REJECTED
}

enum NotificationType {
  RFQ
  QUOTATION
  SHIPMENT
  MESSAGE
  MEETING
  SYSTEM
}

enum AgentOnboardingStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

model User {
  id              String    @id @default(cuid())
  name            String
  surname         String?
  email           String    @unique
  passwordHash    String?
  googleId        String?   @unique
  role            UserRole
  phone           String?
  mobile          String?
  age             Int?
  occupation      String?
  dob             DateTime?
  avatar          String?
  address         String?
  companyName     String?
  gstNumber       String?
  country         String?
  emailVerified   DateTime?
  verified        Boolean   @default(false)
  profileComplete Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  buyer           Buyer?
  agent           Agent?
  supplier        Supplier?

  rfqs            RFQ[]            @relation("BuyerRFQs")
  agentRFQs       RFQ[]            @relation("AgentRFQs")
  conversations   Conversation[]   @relation("ConversationParticipants")
  messages        Message[]
  notifications   Notification[]
  accounts        Account[]
  sessions        Session[]
  sampleOrders    SampleOrder[]    @relation("UserSampleOrders")
  agentOrders     SampleOrder[]    @relation("AgentSampleOrders")
  loginLogs       LoginLog[]
}

model Buyer {
  userId             String   @id
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessType       String?
  sourcingCategories Json
  totalOrders        Int      @default(0)
}

model Agent {
  userId             String                @id
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialization     Json
  region             String?
  experience         Int                   @default(0)
  verificationStatus String                @default("PENDING")
  rating             Float                 @default(0)
  isOnline           Boolean               @default(false)
  onboardingStatus   AgentOnboardingStatus @default(PENDING)
  bio                String?               @db.Text
  profileImage       String?
  languages          Json
  responseTime       String?
  completedDeals     Int                   @default(0)
  onlineAt           DateTime?
}

model Supplier {
  userId         String   @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  factoryName    String?
  exportLicense  String?
  certifications Json
  trustScore     Int      @default(0)
  city           String?
  imageUrl       String?

  quotations     Quotation[]
}

model Product {
  id           String        @id @default(cuid())
  title        String
  description  String        @db.Text
  price        Float
  salePrice    Float?
  chinaCost    Float?
  indiaCost    Float?
  category     String
  tags         Json
  images       Json
  stock        Int           @default(0)
  sku          String?       @unique
  status       ProductStatus @default(DRAFT)
  isFeatured   Boolean       @default(false)
  adminId      String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sampleOrders SampleOrder[]
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  ctaLabel  String   @default("Shop Now")
  ctaHref   String   @default("/categories")
  badge     String?
  imageUrl  String?
  gradient  String   @default("from-blue-900 via-blue-800 to-indigo-900")
  isActive  Boolean  @default(true)
  order     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String   @id @default(cuid())
  name      String
  icon      String   @default("Package")
  color     String   @default("blue")
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RFQ {
  id               String      @id @default(cuid())
  code             String      @unique
  buyerId          String
  buyer            User        @relation("BuyerRFQs", fields: [buyerId], references: [id])
  agentId          String?
  agent            User?       @relation("AgentRFQs", fields: [agentId], references: [id])
  title            String
  description      String      @db.Text
  category         String
  quantity         Int
  moq              Int?
  budget           Float
  currency         String      @default("USD")
  deliveryTimeline String?
  status           RFQStatus   @default(PENDING)
  priority         String      @default("MEDIUM")
  imageUrl         String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  quotations       Quotation[]
  orders           Order[]
  samples          Sample[]
  attachments      Attachment[]
}

model Quotation {
  id              String           @id @default(cuid())
  rfqId           String
  rfq             RFQ              @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplierId      String
  supplier        Supplier         @relation(fields: [supplierId], references: [userId])
  agentId         String
  unitPrice       Float
  moq             Int
  leadTime        String
  totalPrice      Float
  currency        String           @default("USD")
  certifications  Json
  notes           String?          @db.Text
  status          QuotationStatus  @default(PENDING)
  validUntil      DateTime?
  createdAt       DateTime         @default(now())

  orders          Order[]
}

model Order {
  id               String         @id @default(cuid())
  code             String         @unique
  rfqId            String
  rfq              RFQ            @relation(fields: [rfqId], references: [id])
  quotationId      String?
  quotation        Quotation?     @relation(fields: [quotationId], references: [id])
  buyerId          String
  productTitle     String
  supplierName     String
  quantity         Int
  totalAmount      Float
  currency         String         @default("USD")
  status           OrderStatus    @default(PENDING)
  paymentStatus    PaymentStatus  @default(PENDING)
  expectedDelivery DateTime?
  progress         Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  shipments        Shipment[]
}

model Shipment {
  id             String          @id @default(cuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  trackingNumber String          @unique
  carrier        String
  origin         String
  destination    String
  status         ShipmentStatus  @default(PREPARING)
  containerType  String?
  weight         String?
  eta            DateTime?
  createdAt      DateTime        @default(now())

  events         ShipmentEvent[]
}

model ShipmentEvent {
  id          String   @id @default(cuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status      String
  location    String?
  description String?
  timestamp   DateTime @default(now())
}

model Sample {
  id             String       @id @default(cuid())
  rfqId          String
  rfq            RFQ          @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  productTitle   String
  supplierName   String
  status         SampleStatus @default(REQUESTED)
  trackingNumber String?
  qualityScore   Int          @default(0)
  notes          String?      @db.Text
  requestedAt    DateTime     @default(now())
  receivedAt     DateTime?
}

model Conversation {
  id           String    @id @default(cuid())
  participants User[]    @relation("ConversationParticipants")
  rfqCode      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  messages     Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  content        String       @db.Text
  attachments    Json?
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String           @db.Text
  type      NotificationType
  read      Boolean          @default(false)
  href      String?
  createdAt DateTime         @default(now())
}

model Attachment {
  id        String   @id @default(cuid())
  rfqId     String?
  rfq       RFQ?     @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  name      String
  url       String
  type      String
  size      Int?
  createdAt DateTime @default(now())
}

enum SampleOrderStatus {
  REQUESTED
  QUOTED
  PAYMENT_PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model SampleOrder {
  id            String            @id @default(cuid())
  code          String            @unique
  userId        String
  user          User              @relation("UserSampleOrders", fields: [userId], references: [id])
  agentId       String?
  agent         User?             @relation("AgentSampleOrders", fields: [agentId], references: [id])
  productId     String
  product       Product           @relation(fields: [productId], references: [id])
  productTitle  String
  quantity      Int               @default(1)
  status        SampleOrderStatus @default(REQUESTED)
  quotedPrice   Float?
  notes         String?
  razorpayOrderId String?
  razorpayPaymentId String?
  isBulk        Boolean           @default(false)
  trackingInfo  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model OtpCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

model LoginLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String
  mode      String   // "ADMIN" | "OTP"
  status    String   // "SUCCESS" | "FAILURE"
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([createdAt])
}

// NextAuth tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Event {
  id           String         @id @default(cuid())
  title        String
  description  String         @db.Text
  city         String
  country      String         @default("India")
  costPerSeat  Float
  mrp          Float?
  startDate    DateTime
  endDate      DateTime
  bookingEndDate DateTime?
  totalSeats   Int
  bookedSeats  Int            @default(0)
  images       Json
  overview     String?        @db.Text
  overviewHeading String?
  highlights   Json?
  inclusions   Json?
  exclusions   Json?
  minAge       Int?
  maxAge       Int?
  happyTravellers Int?
  isActive     Boolean        @default(true)
  eventType    EventType      @default(BUSINESS_TOUR)
  adminId      String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  bookings     EventBooking[]
  days         EventDay[]
  memories     EventMemoryDay[]
  enquiries    EventEnquiry[]
}

model EventBooking {
  id                  String   @id @default(cuid())
  eventId             String
  event               Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId              String
  userName            String
  userEmail           String
  seats               Int      @default(1)
  totalAmount         Float
  paymentStatus       String   @default("PENDING")
  razorpayOrderId     String?
  razorpayPaymentId   String?
  razorpaySignature   String?
  receiptSent         Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// Day-wise itinerary for an Event/Tour
model EventDay {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  dayNumber   Int
  heading     String?
  title       String
  description String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([eventId, dayNumber])
}

// Standalone memories for marketing marquee (uploaded from admin)
model Memory {
  id        String   @id @default(cuid())
  title     String?
  imageUrl  String   // single image URL
  order     Int      @default(0) // for sorting
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Post-event day-wise memories (photos) to showcase past events
model EventMemoryDay {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  dayNumber Int
  title     String?
  images    Json // uploaded image URLs
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, dayNumber])
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

enum EventType {
  BUSINESS_TOUR
  TRADE_FAIR
}

// Enquiries raised from the event detail page or general contact
model EventEnquiry {
  id        String        @id @default(cuid())
  eventId   String?
  event     Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  message   String?
  status    EnquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
}

// Generic consultation requests from the homepage modal
model Consultation {
  id            String        @id @default(cuid())
  firstName     String
  lastName      String
  email         String
  phone         String
  country       String
  businessStage String
  message       String?
  service       String?
  mode          String        // "FIND" | "MANAGE"
  status        EnquiryStatus @default(NEW)
  createdAt     DateTime      @default(now())
}

model Review {
  id           String   @id @default(cuid())
  name         String
  subtitle     String?
  email        String?
  rating       Int      @default(5)
  text         String   @db.Text
  profileImage String?
  isVisible    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Faq {
  id         String   @id @default(cuid())
  question   String
  answer     String?
  askedBy    String?
  askedByEmail String?
  isAnswered Boolean  @default(false)
  isVisible  Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CatalogueItem {
  id          String              @id @default(cuid())
  title       String
  description String              @db.Text
  image       String?
  price       Float
  isActive    Boolean             @default(true)
  order       Int                 @default(0)
  adminId     String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  purchases   CataloguePurchase[]
}

model CataloguePurchase {
  id                  String        @id @default(cuid())
  itemId              String
  item                CatalogueItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId              String
  userName            String
  userEmail           String
  totalAmount         Float
  paymentStatus       String        @default("PENDING")
  razorpayOrderId     String?
  razorpayPaymentId   String?
  razorpaySignature   String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

// ───────────────────────────────────────────────────────────────────────────────
// Social media presence (homepage section configurable by admin)
// ───────────────────────────────────────────────────────────────────────────────

enum SocialPlatform {
  YOUTUBE
  INSTAGRAM
}

model SocialConfig {
  id               String   @id @default(cuid())
  youtubeVideoUrl  String?
  youtubeAltVideoUrl String?
  instagramReelUrl String?
  adminId          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SocialAccount {
  id        String         @id @default(cuid())
  platform  SocialPlatform
  name      String
  url       String
  order     Int            @default(0)
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

// ───────────────────────────────────────────────────────────────────────────────
// Marketing Services (admin managed, shown on homepage)
// ───────────────────────────────────────────────────────────────────────────────
model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  short       String?
  description String?  @db.Text
  icon        String   @default("Package")
  imageUrl    String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SystemConfig {
  id                String   @id @default(cuid())
  smtpHost          String?
  smtpPort          Int?
  smtpUser          String?
  smtpPassword      String?
  smtpFrom          String?
  razorpayKeyId     String?
  razorpayKeySecret String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
